generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String?  @db.VarChar(255)
  email        String   @unique(map: "email") @db.VarChar(255)
  phone        String?  @db.VarChar(20)
  password     String?  @db.VarChar(255)
  profileImage String?  @db.VarChar(500) @map("profile_image")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Alat {
  id          Int      @id @default(autoincrement())
  idFms       String   @unique @db.VarChar(50) @map("id_fms")
  noPlat      String   @db.VarChar(20) @map("no_plat")
  jenisAlat   String   @db.VarChar(100) @map("jenis_alat")
  detailAlat  String?  @db.Text @map("detail_alat")
  gambar      String?  @db.VarChar(500)
  status      String   @default("Aktif") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  kalibrasi   Kalibrasi[]

  @@map("alat")
}

model Operator {
  id          Int      @id @default(autoincrement())
  nama        String   @db.VarChar(255)
  noTelp      String?  @db.VarChar(20) @map("no_telp")
  divisi      String?  @db.VarChar(100)
  idCardNfc   String?  @db.VarChar(100) @map("id_card_nfc")
  jabatan     String?  @db.VarChar(100)
  alamat      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("operator")
}

model Lokasi {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  latitude    String   @db.VarChar(50)
  longitude   String   @db.VarChar(50)
  radius      Int      @default(0)
  type        String?  @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("lokasi")
}

model Kalibrasi {
  id              Int      @id @default(autoincrement())
  alatId          Int      @map("alat_id")
  empty           Int      @default(0)
  full            Int      @default(1023)
  kapasitasTangki Int      @default(0) @map("kapasitas_tangki")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  alat            Alat     @relation(fields: [alatId], references: [id], onDelete: Cascade)

  @@map("kalibrasi")
}

model Pengawas {
  id           Int      @id @default(autoincrement())
  nama         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  password     String   @db.VarChar(255)
  noTelp       String?  @db.VarChar(20) @map("no_telp")
  fotoProfil   String?  @db.VarChar(500) @map("foto_profil")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("pengawas")
}